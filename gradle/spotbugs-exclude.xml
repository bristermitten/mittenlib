<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 
      Exclude EI_EXPOSE_REP, EI_EXPOSE_REP2, and CT_CONSTRUCTOR_THROW for architectural "service" types.
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP" />
            <Bug pattern="EI_EXPOSE_REP2" />
            <Bug pattern="CT_CONSTRUCTOR_THROW" />
        </Or>
        <Or>
            <Class name="~me\.bristermitten\.mittenlib\.ListenerRegistration" />
            <Class name="~me\.bristermitten\.mittenlib\.MittenLibCoreModule" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.ConfigModule" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.ConfigDataModule" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.paths\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.provider\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.reader\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.config\.writer\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.files\..*FileType" />
            <Class name="~me\.bristermitten\.mittenlib\.files\.yaml\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.files\.json\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotations\.compile\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotations\.parser\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotations\.exception\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotations\.util\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.lang\.format\.hook\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.watcher\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.gui\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.demo\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotation\.benchmark\..*" />
            <!-- Record/Union Specs are internal and used by processors -->
            <Class name="~me\.bristermitten\.mittenlib\.codegen\.record\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.codegen\.union\..*" />
            <Class name="~me\.bristermitten\.mittenlib\.annotations\.ast\..*" />
        </Or>
    </Match>

    <!-- Exclude generated code by package name -->
    <Match>
        <Package name="~.*\.generated.*" />
    </Match>

    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
        <Or>
            <Class name="~me\.bristermitten\.mittenlib\.config\.paths\.PluginConfigInitializationStrategy" />
            <Class name="~me\.bristermitten\.mittenlib\.watcher\.FileWatcherService" />
        </Or>
    </Match>

    <Match>
        <Or>
            <Bug pattern="SF_SWITCH_NO_DEFAULT" />
            <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
            <Bug pattern="DLS_DEAD_LOCAL_STORE" />
            <Bug pattern="NM_METHOD_NAMING_CONVENTION" />
        </Or>
    </Match>

    <!-- Exclude test classes and generated test classes from static analysis -->
    <Match>
        <Class name="~.*Test" />
    </Match>
    <Match>
        <Package name="~me\.bristermitten\.mittenlib\.annotations\.integration(\..*)?" />
    </Match>
    <Match>
        <Package name="~me\.bristermitten\.mittenlib\.codegen(\..*)?" />
    </Match>
    <Match>
        <Package name="~me\.bristermitten\.mittenlib\.annotation\.benchmark(\..*)?" />
    </Match>
</FindBugsFilter>
